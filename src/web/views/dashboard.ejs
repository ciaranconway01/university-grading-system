<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HEd Class - Dashboard </title>
</head>

<body>
    <header>
        <h2> HeDClass Dashboard</h2>
     <nav>
        User: <%= username %> | Role: <%= role %> | 
        
        <% if (role === 'registry_admin') { %>
            <a href='/admin'>Registry Admin Area</a> |
        <% } else if (role === 'classification_officer') { %>
            <a href='/officer'>Officer Workspace</a> |
        <% } %>

        <a href='/logout'>Log Out</a>
    </nav>
        <hr>
    </header>
    <main>
        <h3> Welcome to the Dashboard! </h3>
    </main>

</body>

</html>