<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classification Officer Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4 mb-4 shadow">
        <span class="navbar-brand mb-0 h1">HeDClass - Classification Officer</span>
        <div class="text-white align-items-center d-flex">
            <span class="me-3">User: <%= username %> | Role: Classification Officer</span>
            <a href='/logout' class="btn btn-outline-light btn-sm">Log Out</a>
        </div>
    </nav>
    <hr>

    <main class="container mt-5 mb-5">
        <h3>1. Select Cohort</h3>
        <p>Choose an assigned programme to view.</p>

        <div>
            <label>Select Programme:</label><br>
            <select id="programmeSelect" class="form-select border-primary w-50">
                <option value="">-- Choose a Programme --</option>
                <% programmes.forEach(function(prog) { %>
                    <option value="<%= prog.programme_id %>">
                        <%= prog.name %>
                    </option>
                    <% }); %>
            </select>
        </div>

        <hr>

        <h3>2. Cohort Data Management</h3>
        <p>Current list of students for the selected programme.</p>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <div style="max-width: 600px; margin: 20px 0;">
            <canvas id="classificationChart"></canvas>
        </div>

        <table class="table table-hover table-bordered bg-white shadow-sm align-middle">
            <thead class="table-light">
                <tr style="background-color: #f2f2f2;">
                    <th>Student No.</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Proposed Class</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="studentTableBody">
                <tr>
                    <td colspan="5" style="text-align: center; color: gray;">
                        <em>Please select a programme from the dropdown above to load candidates.</em>
                    </td>
                </tr>
            </tbody>
        </table>
  

    <hr>

    <h3>3. Enroll New Candidate</h3>
    <p>Manually add a new student to an assigned cohort.</p>

    <form action="/officer/add-student" method="POST">
        <div>
            <label>Select Programme:</label><br>
            <select name="programme_id" class="form-select mb-3" required>
                <option value="">-- Choose Programme --</option>
                <% programmes.forEach(function(prog) { %>
                    <option value="<%= prog.programme_id %>">
                        <%= prog.name %>
                    </option>
                    <% }); %>
            </select>
        </div>
        <br>

        <div>
            <label class="form-label fw-bold">Student Number:</label>
            <input type="text" name="student_number" class="form-control mb-3" required>
        </div>

        <div>
            <label class="form-label fw-bold">First Name:</label>
            <input type="text" name="first_name" class="form-control mb-3" required>
        </div>

        <div>
            <label class="form-label fw-bold">Last Name:</label>
            <input type="text" name="last_name" class="form-control mb-3" required>
        </div>
        <br>

        <button type="submit" class="btn btn-success mt-2">Create Student Profile</button>
    </form>
</main>

    <script>
        const dropdown = document.getElementById('programmeSelect');
        const tableBody = document.getElementById('studentTableBody');

        let myChart = null;

        dropdown.addEventListener('change', async function () {
            const programmeId = this.value;

            if (myChart) {
                myChart.destroy();
            }

            if (!programmeId) {
                tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: gray;"><em>Please select a programme from the dropdown above to load candidates.</em></td></tr>';
                return;
            }

            tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center;"><strong>Loading student data...</strong></td></tr>';

            try {
                const response = await fetch('/officer/api/students/' + programmeId);
                const students = await response.json();

                if (students.error) {
                    tableBody.innerHTML = `<tr><td colspan="5" style="color: red;">Error: ${students.error}</td></tr>`;
                    return;
                }

                if (students.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center;">No students found in this cohort.</td></tr>';
                    return;
                }

                let htmlRows = '';
                let counts = {};

                students.forEach(student => {
                    const finalClassification = student.manual_override_classification || student.calculated_classification || 'Pending';
                    counts[finalClassification] = (counts[finalClassification] || 0) + 1;

                    htmlRows += `
                        <tr>
                            <td>${student.student_number}</td>
                            <td>${student.first_name}</td>
                            <td>${student.last_name}</td>
                            <td><strong>${finalClassification}</strong></td>
                            <td>
                                <a href="/officer/review/${student.student_id}" class="btn btn-sm btn-outline-primary me-2">
                                    Review Grades
                                </a>
                                
                                <form action="/officer/delete-student/${student.student_id}" method="POST" class="d-inline">
                                    <button type="submit" onclick="return confirm('Are you sure you want to permanently delete this student?');" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    `;
                    
                });

                tableBody.innerHTML = htmlRows;

                const ctx = document.getElementById('classificationChart');
                const chartLabels = Object.keys(counts);
                const chartData = Object.values(counts);

                myChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: chartLabels,
                        datasets: [{
                            label: 'Number of Students',
                            data: chartData,
                            backgroundColor: ['#4CAF50', '#2196F3', '#FFEB3B', '#FF9800', '#9E9E9E', '#F44336'],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        indexAxis: 'y'
                    }
                });

            } catch (error) {
                console.error("API Fetch Error:", error);
                tableBody.innerHTML = '<tr><td colspan="5" style="color: red;">A network error occurred while loading data.</td></tr>';
            }
        });
    </script>
</body>

</html>