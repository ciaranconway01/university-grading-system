<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registry Admin</title>
</head>

<body>
    <h2>HeDClass - Registry Administration</h2>
    <nav>
        User: <%= username %> | Role = <%=role %> |
                <a href='/logout'> Log Out</a>
    </nav>
    <hr>

    <main>
        <h3> 1. Create a New Programme</h3>
        <p>Define a new degree and its base classification rules. The weighting must equal to 1.0</p>

        <form action="/admin/add-programme" method="POST">
            <div>
                <label>Programme Name:</label><br>
                <input type="text" name="programme_name" required>
            </div>
            <br>
            <div>
                <label>Year 2 Weighting: </label><br>
                <input type="number" step="0.01" min="0" max="1" name="y2_weighting" required>
            </div>
            <br>
            <div>
                <label>Year 3 Weighting: </label><br>
                <input type="number" step="0.01" min="0" max="1" name="y3_weighting" required>
            </div>
            <br>
            <button type="submit">Create Programme</button>
        </form>

        <hr>

        <h3>2. Update Programme Rules</h3>
        <p>Change the weightings for an existing degree.</p>

        <form action="/admin/update-programme" method="POST">
            <div>
                <label>Select Programme:</label><br>
                <select name="programme_id" required>
                    <% programmes.forEach(function(prog) { %>
                        <option value="<%= prog.programme_id %>">
                            <%= prog.name %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <br>
            <div>
                <label>New Year 2 Weighting:</label><br>
                <input type="number" step="0.01" min="0" max="1" name="y2_weighting" required>
            </div>
            <br>
            <div>
                <label>New Year 3 Weighting:</label><br>
                <input type="number" step="0.01" min="0" max="1" name="y3_weighting" required>
            </div>
            <br>
            <button type="submit">Update Weightings</button>
        </form>

        <hr>

        <h3>3. Delete Programme</h3>
        <p style="color: red;"><strong>Warning:</strong> Deleting a programme will also remove all officers assigned to
            it.</p>

        <form action="/admin/delete-programme" method="POST">
            <div>
                <label>Select Programme to Delete:</label><br>
                <select name="programme_id" required>
                    <% programmes.forEach(function(prog) { %>
                        <option value="<%= prog.programme_id %>">
                            <%= prog.name %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <br>
            <button type="submit"
                style="background-color: #dc3545; color: white; border: none; padding: 5px 10px; cursor: pointer;">
                Permanently Delete Programme
            </button>
        </form>

        <hr>

        <h3> 4. Create New Classification Officer.</h3>
        <p> Use this form to create a new Classification Officer.</p>


        <form action="/admin/add-officer" method="POST">
            <div>
                <label> Officer Username</label><br>
                <input type="text" name="new_username" required>
            </div>
            <br>

            <div>
                <label> Password</label> <br>
                <input type="password" name="new_password" required>
            </div>
            <br>

            <div>
                <label> Assign to Programme</label> <br>
                <select name="programme_id" required>
                    <% programmes.forEach(function(prog) { %>
                        <option value="<%= prog.programme_id %>">
                            <%= prog.name %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <br>
            <button type="submit">Create Classification Officer</button>
        </form>

        <hr>

        <h3> 5. Assign Existing Officers</h3>
        <p> Give an existing officer access to another programme.</p>

        <form action="/admin/assign-officer" method="POST">
            <div>
                <label>Select Existing Officer:</label><br>
                <select name="user_id" required>
                    <% officers.forEach(function(officer) { %>
                        <option value="<%= officer.user_id %>">
                            <%= officer.username %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <br>

            <div>
                <label>Select Programme to Assign:</label><br>
                <select name="programme_id" required>
                    <% programmes.forEach(function(prog) { %>
                        <option value="<%= prog.programme_id %>">
                            <%= prog.name %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <br>

            <button type="submit">Assign to Additional Programme</button>
        </form>

        <hr>
        <h3>6. Delete Classification Officer</h3>
        <p style="color: red;"><strong>Warning:</strong> This permanently deletes the Classification Officer's account</p>

        <form action="/admin/delete-officer" method="POST">
            <div>
                <label>Select Officer to Delete:</label><br>
                <select name="user_id" required>
                    <% officers.forEach(function(officer) { %>
                        <option value="<%= officer.user_id %>">
                            <%= officer.username %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <br>
            <button type="submit"
                style="background-color: #dc3545; color: white; border: none; padding: 5px 10px; cursor: pointer;">
                Permanently Delete Officer
            </button>
        </form>

        <hr>

        <h3>7. Programme & Staff Directory</h3>
        <p>Current overview of all degrees, weightings, and assigned personnel.</p>

        <table border="1" cellpadding="10" style="width:100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="background-color: #f2f2f2;">
                    <th>Programme Name</th>
                    <th>Year 2 Weighting</th>
                    <th>Year 3 Weighting</th>
                    <th>Assigned Officer</th>
                </tr>
            </thead>
            <tbody>
                <% if (programmeRegister.length> 0) { %>
                    <% programmeRegister.forEach(function(row) { %>
                        <tr>
                            <td><strong>
                                    <%= row.programme_name %>
                                </strong></td>
                            <td>
                                <%= Math.round(row.y2_weighting * 100) %>%
                            </td>
                            <td>
                                <%= Math.round(row.y3_weighting * 100) %>%
                            </td>
                            <td>
                                <% if (row.officer_username) { %>
                                    <%= row.officer_username %>
                                        <% } else { %>
                                            Unassigned
                                            <% } %>
                            </td>
                        </tr>
                        <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4">No programmes found in system.</td>
                                </tr>
                                <% } %>
            </tbody>
        </table>


    </main>

</body>

</html>